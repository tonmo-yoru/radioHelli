Sub 防除集計表作成()
    Dim ws As Worksheet
    Set ws = Worksheets.Add
    ws.Name = "防除集計表"
    
    With ws
        .Cells.RowHeight = 14.5
        .Cells.ColumnWidth = 2.8
        .Rows(2).RowHeight = 23.25
        Dim rw As Long
        For rw = 61 To 70
            Sheets("MENU").Rows(rw).Copy .Rows(rw - 59)
        Next rw
    End With
End Sub



Sub 防除集計表データ抽出()


