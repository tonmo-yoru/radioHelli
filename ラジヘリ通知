Private Sub 表示_Click()
    On Error Resume Next
    With Sheets("クエリ1")
        .Unprotect
        Dim cols As Variant: cols = Array(1, 4, 5, 6, 11, 12, 13)
        Dim col As Variant
        For Each col In cols
            .Columns(col).Hidden = False
        Next col
        .Activate
    End With
    On Error GoTo 0
End Sub



