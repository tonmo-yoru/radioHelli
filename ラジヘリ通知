   .Cells(12, 30).Value = Sheets("引受面積一覧").Cells(3, 11).Value '★欄外共済番号


      For hmrw = 2 To N

   If .Cells(bi + 13, 30).Value = .Cells(bi + 12, 30).Value Then
'    If ans Then
 GoTo AA

 Else
       .Cells(bi + 5, 6) = Sheets("引受面積一覧").Cells(hmrw, 2).Value                       '集落名
       .Cells(bi + 7, 7) = Sheets("引受面積一覧").Cells(hmrw, 3).Value '氏名
       .Cells(bi + 9, 3) = Sheets("引受面積一覧").Cells(hmrw, 11).Value '★共済番号
       .Cells(bi + 8, 21).NumberFormat = "@"                                 'プロパティに文字を指定
