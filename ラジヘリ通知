AA:
           Sheets("MENU").Rows(70).Copy .Rows(bi + 12)
           .Cells(bi + 11, 30) = Sheets("引受面積一覧").Cells(hmrw, 11).Value '★共済番号
           .Cells(bi + 11, 3) = Sheets("引受面積一覧").Cells(hmrw, 7).Value '耕地番号
           .Cells(bi + 11, 6) = Sheets("引受面積一覧").Cells(hmrw, 8).Value '地名地番
           .Cells(bi + 11, 17) = Sheets("引受面積一覧").Cells(hmrw, 10).Value '防除面積
           .Cells(bi + 11, 21).NumberFormat = "#,##0"                       'プロパティに通貨を指定
           .Cells(bi + 11, 21) = Sheets("引受面積一覧").Cells(hmrw, 10).Value * tanka '防除金額算出
           .Cells(bi + 12, 30).Value = Sheets("引受面積一覧").Cells(hmrw + 1, 11).Value '★欄外共済番号

 End If

           If .Cells(bi + 12, 30).Value = .Cells(bi + 11, 30).Value Then 'もし共済番号が上の行と同じだったら
           bi = bi + 1

           Else
           Sheets("MENU").Rows(111).Copy .Rows(bi + 12)
           .Rows(bi + 13).PageBreak = xlPageBreakManual
           bi = .Cells(Rows.Count, 3).End(xlUp).row

           '----------------------------------------------
           '  合計　防除面積　＆　金額
           '----------------------------------------------
           ha = 0
           For rw = bi - 1 To 1 Step -1
           If .Cells(rw, 30).Value = Empty Then
           Exit For
           Else
               ha = ha + .Cells(rw, 17).Value
'                 .Cells(bi, 17).Value = ha
           End If
           Next
               .Cells(bi, 17).NumberFormat = "#,##0"     'プロパティに通貨を指定
              .Cells(bi, 17).Value = ha

            mny = 0
           For rw = bi - 1 To 1 Step -1
           If .Cells(rw, 30).Value = Empty Then
           Exit For
           Else
               mny = mny + .Cells(rw, 21).Value
           End If
           Next
               .Cells(bi, 21).NumberFormat = "#,##0"     'プロパティに通貨を指定
                .Cells(bi, 21).Value = mny





           For rw = 61 To 70
           Sheets("MENU").Rows(rw).Copy .Rows(bi + rw - 59)
           Next rw
           .Cells(bi + 12, 30).Value = Sheets("引受面積一覧").Cells(hmrw, 11).Value '★欄外共済番号

           End If



       Next hmrw

           .Columns(30).Delete
           For i = bi + 12 To bi + 1 Step -1
           .Rows(i).Delete
           Next



    MsgBox "終了しました", vbOKOnly

  End With


End Sub



