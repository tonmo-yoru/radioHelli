'■■■■■■■■■■■■　引受面積に罫線作成　■■■■■■■■■■■■■■■

Sub 罫線()
    With Sheets("引受面積一覧")
        Dim N As Long: N = .Cells(.Rows.Count, 1).End(xlUp).Row
        Dim S As Long
        For S = 1 To N
            If .Cells(S, 1).Value <> "" Then
                .Range("A" & S & ":M" & S).Borders.LineStyle = xlContinuous
            End If
        Next S
    End With
End Sub




